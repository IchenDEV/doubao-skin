        "codeBackground": "#1b1730",
        "codeHeaderBackground": "#282245",
        "selectionColor": "rgba(160,107,232,0.24)",
        "scrollbarColor": "rgba(160,107,232,0.26)",
        "scrollbarHoverColor": "rgba(160,107,232,0.42)"
      },
      "icons": {
        "main": "icons/main.svg"
      }
    }
  }
}
