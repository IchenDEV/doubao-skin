{
  "$schema": "../../design/theme-standard/theme-v2.schema.json",
  "schemaVersion": 2,
  "id": "ocean-cyan",
  "name": "海洋青",
  "description": "石墨蓝底 + 青色强调色",
  "version": "1.0.0",
  "author": "豆包主题",
  "preview": {
    "image": "preview.jpg",
    "aspectRatio": "16:9",
    "appearance": "dark",
    "accent": "#1f8c9b"
  },
  "store": {
    "category": "pure",
    "tags": [
      "深色",
      "青色",
      "清爽"
    ],
    "sortOrder": 1
  },
  "appearance": "both",
  "typography": {
    "ui": "-apple-system, BlinkMacSystemFont, \"PingFang SC\", \"Helvetica Neue\", sans-serif",
    "body": "-apple-system, BlinkMacSystemFont, \"PingFang SC\", \"Helvetica Neue\", sans-serif",
    "code": "\"SFMono-Regular\", Menlo, Monaco, monospace",
    "scale": 1,
    "lineHeight": 1.56
  },
  "layout": {
    "density": "comfortable",
    "sidebarWidth": 248,
    "chatMaxWidth": 880,
    "composerMaxWidth": 740,
    "selfMessageMaxWidth": 380,
    "chatMargin": 28
  },
  "composer": {
    "background": "#1f2330",
    "border": "1px solid rgba(47,212,236,0.28)",
    "textColor": "#e0e6f2",
    "placeholderColor": "rgba(224,230,242,0.52)",
    "caretColor": "rgba(47,212,236,1)",
    "iconColor": "rgba(224,230,242,0.72)",
    "sendButtonBackground": "rgba(47,212,236,1)",
    "sendButtonIconColor": "#080b14",
    "radius": 18,
    "minHeight": 52,
    "maxHeight": 260,
    "padding": 12,
    "gap": 8,
    "iconSize": 20
  },
  "content": {
    "chatBackground": "#151824",
    "userMessageBackground": "rgba(47,212,236,1)",
    "userMessageText": "#080b14",
    "assistantMessageBackground": "#1f2330",
    "assistantMessageText": "#e0e6f2",
    "codeBackground": "#1d2130",
    "codeHeaderBackground": "#2a2f42",
    "selectionColor": "rgba(47,212,236,0.24)",
    "scrollbarColor": "rgba(47,212,236,0.26)",
    "scrollbarHoverColor": "rgba(47,212,236,0.42)"
  },
  "effects": {
    "radiusScale": 1,
    "shadow": "0 12px 32px rgba(0,0,0,.28)",
    "blur": 10,
    "motion": "gentle",
    "transitionMs": 150
  },
  "variants": {
    "light": {
      "composer": {
        "background": "rgba(255,255,255,0.96)",
        "border": "1px solid rgba(31,140,155,0.28)",
        "textColor": "#202124",
        "placeholderColor": "rgba(32,33,36,0.56)",
        "caretColor": "#1f8c9b",
        "iconColor": "rgba(32,33,36,0.78)",
        "sendButtonBackground": "#1f8c9b",
        "sendButtonIconColor": "#ffffff",
        "radius": 18,
        "minHeight": 52,
        "maxHeight": 260,
        "padding": 12,
        "gap": 8,
        "iconSize": 20
      },
      "content": {
        "chatBackground": "rgba(248,249,251,0.88)",
        "userMessageBackground": "#1f8c9b",
        "userMessageText": "#ffffff",
        "assistantMessageBackground": "rgba(255,255,255,0.94)",
        "assistantMessageText": "#202124",
        "codeBackground": "rgba(32,33,36,0.07)",
        "codeHeaderBackground": "rgba(32,33,36,0.11)",
        "selectionColor": "rgba(31,140,155,0.22)",
        "scrollbarColor": "rgba(31,140,155,0.24)",
        "scrollbarHoverColor": "rgba(31,140,155,0.4)"
      },
      "icons": {
        "main": "icons/main.svg"
      }
    },
    "dark": {
      "composer": {
        "background": "#1f2330",
        "border": "1px solid rgba(47,212,236,0.28)",
        "textColor": "#e0e6f2",
        "placeholderColor": "rgba(224,230,242,0.52)",
        "caretColor": "rgba(47,212,236,1)",
        "iconColor": "rgba(224,230,242,0.72)",
        "sendButtonBackground": "rgba(47,212,236,1)",
        "sendButtonIconColor": "#080b14",
        "radius": 18,
        "minHeight": 52,
        "maxHeight": 260,
        "padding": 12,
        "gap": 8,
        "iconSize": 20
      },
      "content": {
        "chatBackground": "#151824",
        "userMessageBackground": "rgba(47,212,236,1)",
        "userMessageText": "#080b14",
        "assistantMessageBackground": "#1f2330",
        "assistantMessageText": "#e0e6f2",
        "codeBackground": "#1d2130",
        "codeHeaderBackground": "#2a2f42",
        "selectionColor": "rgba(47,212,236,0.24)",
        "scrollbarColor": "rgba(47,212,236,0.26)",
        "scrollbarHoverColor": "rgba(47,212,236,0.42)"
      },
      "icons": {
        "main": "icons/main.svg"
      }
    }
  }
}
