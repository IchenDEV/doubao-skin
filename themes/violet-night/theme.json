{
  "$schema": "../../design/theme-standard/theme-v2.schema.json",
  "schemaVersion": 2,
  "id": "violet-night",
  "name": "暗夜紫",
  "description": "深紫罗兰底 + 紫罗兰强调色（默认主题，验证过效果）",
  "version": "1.0.0",
  "author": "豆皮",
  "preview": {
    "image": "preview.jpg",
    "aspectRatio": "16:9",
    "appearance": "dark",
    "accent": "#8d6fd3"
  },
  "store": {
    "category": "pure",
    "tags": [
      "深色",
      "紫色",
      "专注"
    ],
    "sortOrder": 0
  },
  "appearance": "both",
  "typography": {
    "ui": "-apple-system, BlinkMacSystemFont, \"PingFang SC\", \"Helvetica Neue\", sans-serif",
    "body": "-apple-system, BlinkMacSystemFont, \"PingFang SC\", \"Helvetica Neue\", sans-serif",
    "code": "\"SFMono-Regular\", Menlo, Monaco, monospace",
    "scale": 1,
    "lineHeight": 1.56
  },
  "layout": {
    "density": "comfortable",
    "sidebarWidth": 248,
    "chatMaxWidth": 880,
    "composerMaxWidth": 740,
    "selfMessageMaxWidth": 380,
    "chatMargin": 28
  },
  "composer": {
    "background": "#221d30",
    "border": "1px solid rgba(157,123,234,0.28)",
    "textColor": "#e2ddf2",
    "placeholderColor": "rgba(226,221,242,0.52)",
    "caretColor": "rgba(157,123,234,1)",
    "iconColor": "rgba(226,221,242,0.72)",
    "sendButtonBackground": "rgba(157,123,234,1)",
    "sendButtonIconColor": "#0d0b16",
    "radius": 18,
    "minHeight": 52,
    "maxHeight": 260,
    "padding": 12,
    "gap": 8,
    "iconSize": 20
  },
  "content": {
    "chatBackground": "#16131f",
    "userMessageBackground": "rgba(157,123,234,1)",
    "userMessageText": "#0d0b16",
    "assistantMessageBackground": "#221d30",
    "assistantMessageText": "#e2ddf2",
    "codeBackground": "#1e1a2e",
    "codeHeaderBackground": "#2b2540",
    "selectionColor": "rgba(157,123,234,0.24)",
    "scrollbarColor": "rgba(157,123,234,0.26)",
    "scrollbarHoverColor": "rgba(157,123,234,0.42)"
  },
  "effects": {
    "radiusScale": 1,
    "shadow": "0 12px 32px rgba(0,0,0,.28)",
    "blur": 10,
    "motion": "gentle",
    "transitionMs": 150
  },
  "variants": {
    "light": {
      "composer": {
        "background": "rgba(255,255,255,0.96)",
        "border": "1px solid rgba(141,111,211,0.28)",
        "textColor": "#202124",
        "placeholderColor": "rgba(32,33,36,0.56)",
        "caretColor": "#8d6fd3",
        "iconColor": "rgba(32,33,36,0.78)",
        "sendButtonBackground": "#8d6fd3",
        "sendButtonIconColor": "#ffffff",
        "radius": 18,
        "minHeight": 52,
        "maxHeight": 260,
        "padding": 12,
        "gap": 8,
        "iconSize": 20
      },
      "content": {
        "chatBackground": "rgba(248,249,251,0.88)",
        "userMessageBackground": "#8d6fd3",
        "userMessageText": "#ffffff",
        "assistantMessageBackground": "rgba(255,255,255,0.94)",
        "assistantMessageText": "#202124",
        "codeBackground": "rgba(32,33,36,0.07)",
        "codeHeaderBackground": "rgba(32,33,36,0.11)",
        "selectionColor": "rgba(141,111,211,0.22)",
        "scrollbarColor": "rgba(141,111,211,0.24)",
        "scrollbarHoverColor": "rgba(141,111,211,0.4)"
      },
      "icons": {
        "main": "icons/main.svg"
      }
    },
    "dark": {
      "composer": {
        "background": "#221d30",
        "border": "1px solid rgba(157,123,234,0.28)",
        "textColor": "#e2ddf2",
        "placeholderColor": "rgba(226,221,242,0.52)",
        "caretColor": "rgba(157,123,234,1)",
        "iconColor": "rgba(226,221,242,0.72)",
        "sendButtonBackground": "rgba(157,123,234,1)",
        "sendButtonIconColor": "#0d0b16",
        "radius": 18,
        "minHeight": 52,
        "maxHeight": 260,
        "padding": 12,
        "gap": 8,
        "iconSize": 20
      },
      "content": {
        "chatBackground": "#16131f",
        "userMessageBackground": "rgba(157,123,234,1)",
        "userMessageText": "#0d0b16",
        "assistantMessageBackground": "#221d30",
        "assistantMessageText": "#e2ddf2",
        "codeBackground": "#1e1a2e",
        "codeHeaderBackground": "#2b2540",
        "selectionColor": "rgba(157,123,234,0.24)",
        "scrollbarColor": "rgba(157,123,234,0.26)",
        "scrollbarHoverColor": "rgba(157,123,234,0.42)"
      },
      "icons": {
        "main": "icons/main.svg"
      }
    }
  }
}
