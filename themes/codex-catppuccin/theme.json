{
  "$schema": "../../design/theme-standard/theme-v2.schema.json",
  "schemaVersion": 2,
  "id": "codex-catppuccin",
  "name": "豆包柔紫",
  "description": "柔和的紫色，久看也舒服",
  "version": "1.0.0",
  "author": "豆包主题",
  "preview": {
    "image": "preview.jpg",
    "aspectRatio": "16:9",
    "appearance": "dark",
    "accent": "#856da2"
  },
  "store": {
    "category": "codex",
    "tags": [
      "深色",
      "编辑器",
      "紫色"
    ],
    "sortOrder": 13
  },
  "appearance": "both",
  "typography": {
    "ui": "-apple-system, BlinkMacSystemFont, \"PingFang SC\", \"Helvetica Neue\", sans-serif",
    "body": "-apple-system, BlinkMacSystemFont, \"PingFang SC\", \"Helvetica Neue\", sans-serif",
    "code": "\"SFMono-Regular\", Menlo, Monaco, monospace",
    "scale": 1,
    "lineHeight": 1.56
  },
  "layout": {
    "density": "comfortable",
    "sidebarWidth": 248,
    "chatMaxWidth": 880,
    "composerMaxWidth": 740,
    "selfMessageMaxWidth": 380,
    "chatMargin": 28
  },
  "composer": {
    "background": "#313244",
    "border": "1px solid rgba(203,166,247,0.28)",
    "textColor": "#cdd6f4",
    "placeholderColor": "rgba(205,214,244,0.52)",
    "caretColor": "rgba(203,166,247,1)",
    "iconColor": "rgba(205,214,244,0.72)",
    "sendButtonBackground": "rgba(203,166,247,1)",
    "sendButtonIconColor": "#11111b",
    "radius": 18,
    "minHeight": 52,
    "maxHeight": 260,
    "padding": 12,
    "gap": 8,
    "iconSize": 20
  },
  "content": {
    "chatBackground": "#1e1e2e",
    "userMessageBackground": "rgba(203,166,247,1)",
    "userMessageText": "#11111b",
    "assistantMessageBackground": "#313244",
    "assistantMessageText": "#cdd6f4",
    "codeBackground": "#1e1e2e",
    "codeHeaderBackground": "#313244",
    "selectionColor": "rgba(203,166,247,0.24)",
    "scrollbarColor": "rgba(203,166,247,0.26)",
    "scrollbarHoverColor": "rgba(203,166,247,0.42)"
  },
  "effects": {
    "radiusScale": 1,
    "shadow": "0 12px 32px rgba(0,0,0,.28)",
    "blur": 10,
    "motion": "gentle",
    "transitionMs": 150
  },
  "derivedFrom": "Catppuccin Mocha",
  "sourceUrl": "https://github.com/catppuccin/palette",
