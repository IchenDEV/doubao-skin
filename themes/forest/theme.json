{
  "$schema": "../../design/theme-standard/theme-v2.schema.json",
  "schemaVersion": 2,
  "id": "forest",
  "name": "墨绿",
  "description": "深墨绿底 + 翠绿强调色",
  "version": "1.0.0",
  "author": "豆包主题",
  "preview": {
    "image": "preview.jpg",
    "aspectRatio": "16:9",
    "appearance": "dark",
    "accent": "#368f5e"
  },
  "store": {
    "category": "pure",
    "tags": [
      "深色",
      "绿色",
      "沉静"
    ],
    "sortOrder": 2
  },
  "appearance": "both",
  "typography": {
    "ui": "-apple-system, BlinkMacSystemFont, \"PingFang SC\", \"Helvetica Neue\", sans-serif",
    "body": "-apple-system, BlinkMacSystemFont, \"PingFang SC\", \"Helvetica Neue\", sans-serif",
    "code": "\"SFMono-Regular\", Menlo, Monaco, monospace",
    "scale": 1,
    "lineHeight": 1.56
  },
  "layout": {
    "density": "comfortable",
    "sidebarWidth": 248,
    "chatMaxWidth": 880,
    "composerMaxWidth": 740,
    "selfMessageMaxWidth": 380,
    "chatMargin": 28
  },
  "composer": {
    "background": "#1c2821",
    "border": "1px solid rgba(74,197,130,0.28)",
    "textColor": "#d8e6de",
    "placeholderColor": "rgba(216,230,222,0.52)",
    "caretColor": "rgba(74,197,130,1)",
    "iconColor": "rgba(216,230,222,0.72)",
    "sendButtonBackground": "rgba(74,197,130,1)",
    "sendButtonIconColor": "#09120e",
    "radius": 18,
    "minHeight": 52,
    "maxHeight": 260,
    "padding": 12,
    "gap": 8,
    "iconSize": 20
  },
  "content": {
    "chatBackground": "#121a15",
    "userMessageBackground": "rgba(74,197,130,1)",
    "userMessageText": "#09120e",
    "assistantMessageBackground": "#1c2821",
    "assistantMessageText": "#d8e6de",
    "codeBackground": "#18261e",
    "codeHeaderBackground": "#23362b",
    "selectionColor": "rgba(74,197,130,0.24)",
    "scrollbarColor": "rgba(74,197,130,0.26)",
    "scrollbarHoverColor": "rgba(74,197,130,0.42)"
  },
  "effects": {
    "radiusScale": 1,
    "shadow": "0 12px 32px rgba(0,0,0,.28)",
    "blur": 10,
    "motion": "gentle",
    "transitionMs": 150
  },
  "variants": {
    "light": {
      "composer": {
        "background": "rgba(255,255,255,0.96)",
        "border": "1px solid rgba(54,143,94,0.28)",
        "textColor": "#202124",
        "placeholderColor": "rgba(32,33,36,0.56)",
        "caretColor": "#368f5e",
        "iconColor": "rgba(32,33,36,0.78)",
        "sendButtonBackground": "#368f5e",
        "sendButtonIconColor": "#ffffff",
        "radius": 18,
        "minHeight": 52,
        "maxHeight": 260,
        "padding": 12,
        "gap": 8,
        "iconSize": 20
      },
      "content": {
        "chatBackground": "rgba(248,249,251,0.88)",
        "userMessageBackground": "#368f5e",
        "userMessageText": "#ffffff",
        "assistantMessageBackground": "rgba(255,255,255,0.94)",
        "assistantMessageText": "#202124",
        "codeBackground": "rgba(32,33,36,0.07)",
        "codeHeaderBackground": "rgba(32,33,36,0.11)",
        "selectionColor": "rgba(54,143,94,0.22)",
        "scrollbarColor": "rgba(54,143,94,0.24)",
        "scrollbarHoverColor": "rgba(54,143,94,0.4)"
      },
      "icons": {
        "main": "icons/main.svg"
      }
    },
    "dark": {
      "composer": {
        "background": "#1c2821",
        "border": "1px solid rgba(74,197,130,0.28)",
        "textColor": "#d8e6de",
        "placeholderColor": "rgba(216,230,222,0.52)",
        "caretColor": "rgba(74,197,130,1)",
        "iconColor": "rgba(216,230,222,0.72)",
        "sendButtonBackground": "rgba(74,197,130,1)",
        "sendButtonIconColor": "#09120e",
        "radius": 18,
        "minHeight": 52,
        "maxHeight": 260,
        "padding": 12,
        "gap": 8,
        "iconSize": 20
      },
      "content": {
        "chatBackground": "#121a15",
        "userMessageBackground": "rgba(74,197,130,1)",
        "userMessageText": "#09120e",
        "assistantMessageBackground": "#1c2821",
        "assistantMessageText": "#d8e6de",
        "codeBackground": "#18261e",
        "codeHeaderBackground": "#23362b",
        "selectionColor": "rgba(74,197,130,0.24)",
        "scrollbarColor": "rgba(74,197,130,0.26)",
        "scrollbarHoverColor": "rgba(74,197,130,0.42)"
      },
      "icons": {
        "main": "icons/main.svg"
      }
    }
  }
}
