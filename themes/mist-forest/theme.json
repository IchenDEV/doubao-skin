{
  "$schema": "../../design/theme-standard/theme-v2.schema.json",
  "schemaVersion": 2,
  "id": "mist-forest",
  "name": "雾林",
  "description": "晨雾针叶林光束，翠绿强调色，半透明底透出氛围图",
  "version": "1.0.0",
  "author": "豆包主题",
  "preview": {
    "image": "preview.jpg",
    "aspectRatio": "16:9",
    "appearance": "dark",
    "accent": "#338657"
  },
  "store": {
    "category": "atmosphere",
    "tags": [
      "深色",
      "绿色",
      "自然"
    ],
    "sortOrder": 8
  },
  "appearance": "both",
  "background": {
    "type": "image",
    "src": "bg.jpg",
    "fit": "cover",
    "position": "center",
    "opacity": 1,
    "veil": 0.22,
    "blur": 0,
    "animation": "drift",
    "durationSeconds": 38
  },
  "veil": 0.22,
  "typography": {
    "ui": "-apple-system, BlinkMacSystemFont, \"PingFang SC\", \"Helvetica Neue\", sans-serif",
    "body": "-apple-system, BlinkMacSystemFont, \"PingFang SC\", \"Helvetica Neue\", sans-serif",
    "code": "\"SFMono-Regular\", Menlo, Monaco, monospace",
    "scale": 1,
    "lineHeight": 1.62
  },
  "layout": {
    "density": "spacious",
    "sidebarWidth": 260,
    "chatMaxWidth": 960,
    "composerMaxWidth": 780,
    "selfMessageMaxWidth": 420,
    "chatMargin": 32
  },
  "composer": {
    "background": "rgba(22,36,28,0.92)",
    "border": "1px solid rgba(70,184,120,0.28)",
    "textColor": "#d6eadd",
    "placeholderColor": "rgba(214,234,221,0.52)",
    "caretColor": "rgba(70,184,120,1)",
    "iconColor": "rgba(214,234,221,0.72)",
    "sendButtonBackground": "rgba(70,184,120,1)",
    "sendButtonIconColor": "#090f0c",
    "radius": 20,
    "minHeight": 52,
    "maxHeight": 260,
    "padding": 14,
    "gap": 10,
    "iconSize": 20
  },
  "content": {
    "chatBackground": "rgba(14,22,17,0.52)",
    "userMessageBackground": "rgba(70,184,120,1)",
    "userMessageText": "#090f0c",
    "assistantMessageBackground": "rgba(22,36,28,0.92)",
    "assistantMessageText": "#d6eadd",
    "codeBackground": "#12201a",
    "codeHeaderBackground": "#193026",
