{
  "$schema": "../../design/theme-standard/theme-v2.schema.json",
  "schemaVersion": 2,
  "id": "codex-nord",
  "name": "豆包极光",
  "description": "清爽的蓝色，安静又清晰",
  "version": "1.0.0",
  "author": "豆包主题",
  "preview": {
    "image": "preview.jpg",
    "aspectRatio": "16:9",
    "appearance": "dark",
    "accent": "#597e88"
  },
  "store": {
    "category": "codex",
    "tags": [
      "深色",
      "编辑器",
      "蓝色"
    ],
    "sortOrder": 15
  },
  "appearance": "both",
  "typography": {
    "ui": "-apple-system, BlinkMacSystemFont, \"PingFang SC\", \"Helvetica Neue\", sans-serif",
    "body": "-apple-system, BlinkMacSystemFont, \"PingFang SC\", \"Helvetica Neue\", sans-serif",
    "code": "\"SFMono-Regular\", Menlo, Monaco, monospace",
    "scale": 1,
    "lineHeight": 1.56
  },
  "layout": {
    "density": "comfortable",
    "sidebarWidth": 248,
    "chatMaxWidth": 880,
    "composerMaxWidth": 740,
    "selfMessageMaxWidth": 380,
    "chatMargin": 28
  },
  "composer": {
    "background": "#4c566a",
    "border": "1px solid rgba(136,192,208,0.28)",
    "textColor": "#d8dee9",
    "placeholderColor": "rgba(216,222,233,0.52)",
    "caretColor": "rgba(136,192,208,1)",
    "iconColor": "rgba(216,222,233,0.72)",
    "sendButtonBackground": "rgba(136,192,208,1)",
    "sendButtonIconColor": "#242933",
    "radius": 18,
    "minHeight": 52,
    "maxHeight": 260,
    "padding": 12,
    "gap": 8,
    "iconSize": 20
  },
  "content": {
    "chatBackground": "#2e3440",
    "userMessageBackground": "rgba(136,192,208,1)",
    "userMessageText": "#242933",
    "assistantMessageBackground": "#4c566a",
    "assistantMessageText": "#d8dee9",
    "codeBackground": "#2e3440",
    "codeHeaderBackground": "#3b4252",
    "selectionColor": "rgba(136,192,208,0.24)",
    "scrollbarColor": "rgba(136,192,208,0.26)",
    "scrollbarHoverColor": "rgba(136,192,208,0.42)"
  },
  "effects": {
    "radiusScale": 1,
    "shadow": "0 12px 32px rgba(0,0,0,.28)",
    "blur": 10,
    "motion": "gentle",
    "transitionMs": 150
  },
  "derivedFrom": "Nord",
  "sourceUrl": "https://github.com/nordtheme/nord",
  "sourceCommit": "1cef71605416a222e57225b544540ce0fcec18d4",
  "license": "MIT",
  "variants": {
    "light": {
      "composer": {
        "background": "rgba(255,255,255,0.96)",
        "border": "1px solid rgba(89,126,136,0.28)",
        "textColor": "#202124",
        "placeholderColor": "rgba(32,33,36,0.56)",
        "caretColor": "#597e88",
        "iconColor": "rgba(32,33,36,0.78)",
        "sendButtonBackground": "#597e88",
        "sendButtonIconColor": "#ffffff",
        "radius": 18,
        "minHeight": 52,
        "maxHeight": 260,
        "padding": 12,
        "gap": 8,
        "iconSize": 20
      },
      "content": {
        "chatBackground": "rgba(248,249,251,0.88)",
        "userMessageBackground": "#597e88",
        "userMessageText": "#ffffff",
        "assistantMessageBackground": "rgba(255,255,255,0.94)",
        "assistantMessageText": "#202124",
        "codeBackground": "rgba(32,33,36,0.07)",
        "codeHeaderBackground": "rgba(32,33,36,0.11)",
        "selectionColor": "rgba(89,126,136,0.22)",
        "scrollbarColor": "rgba(89,126,136,0.24)",
        "scrollbarHoverColor": "rgba(89,126,136,0.4)"
      },
      "icons": {
        "main": "icons/main.svg"
      }
    },
    "dark": {
      "composer": {
        "background": "#4c566a",
        "border": "1px solid rgba(136,192,208,0.28)",
