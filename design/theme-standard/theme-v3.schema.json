{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doubao-skin.idevlab.dev/schemas/theme-v3.schema.json",
  "title": "豆皮主题包 v3",
  "description": "面向豆包、豆包工作和 WorkBuddy 的显式多宿主主题包。",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "description",
    "version",
    "author",
    "preview",
    "shared",
    "targets"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 3 },
    "id": { "$ref": "#/$defs/themeId" },
    "name": { "type": "string", "minLength": 2, "maxLength": 16 },
    "description": { "type": "string", "minLength": 1, "maxLength": 80 },
    "version": { "$ref": "#/$defs/semver" },
    "author": { "type": "string", "minLength": 1, "maxLength": 40 },
    "preview": { "$ref": "#/$defs/preview" },
    "store": { "$ref": "#/$defs/store" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "shared": { "$ref": "#/$defs/sharedLayer" },
    "targets": { "$ref": "#/$defs/targets" }
  },
  "additionalProperties": false,
  "$defs": {
    "themeId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "resourcePath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
    },
    "cssPath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*\\.css$"
    },
    "cssList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/cssPath" }
    },
    "appearance": {
      "enum": ["light-only", "dark-only", "both"]
    },
    "preview": {
      "type": "object",
      "required": ["image", "aspectRatio", "appearance", "accent"],
      "properties": {
        "image": { "$ref": "#/$defs/resourcePath" },
        "aspectRatio": { "const": "16:9" },
        "appearance": { "enum": ["light", "dark"] },
        "accent": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
      },
      "additionalProperties": false
    },
    "store": {
      "type": "object",
      "required": ["category", "tags", "sortOrder"],
      "properties": {
        "category": { "enum": ["pure", "atmosphere", "gallery", "codex", "brand", "misc"] },
        "tags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 16 }
        },
        "sortOrder": { "type": "integer", "minimum": 0, "maximum": 9999 }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "inspiredBy": { "type": "string", "minLength": 1, "maxLength": 200 },
        "derivedFrom": { "type": "string", "minLength": 1, "maxLength": 200 },
        "sourceUrl": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "sourceCommit": { "type": "string", "minLength": 1, "maxLength": 128 },
        "sourceVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "sourceAccessedAt": { "type": "string", "format": "date" },
        "sourceDownloads": { "type": "integer", "minimum": 0 },
        "sourceEvidence": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "sourceLicense": { "type": "string", "minLength": 1, "maxLength": 200 },
        "sourceRank": { "type": "integer", "minimum": 1 },
        "sourceSnapshot": { "type": "string", "minLength": 1, "maxLength": 128 },
        "license": { "type": "string", "minLength": 1, "maxLength": 200 },
        "artwork": { "type": "string", "minLength": 1, "maxLength": 300 }
      },
      "additionalProperties": false
    },
    "background": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["image", "video", "gradient"] },
        "src": { "$ref": "#/$defs/resourcePath" },
        "poster": { "$ref": "#/$defs/resourcePath" },
        "gradient": { "type": "string", "minLength": 1, "maxLength": 500 },
        "fit": { "enum": ["cover", "contain", "fill", "none", "scale-down"] },
        "position": { "type": "string", "minLength": 1, "maxLength": 100 },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "veil": { "type": "number", "minimum": 0, "maximum": 1 },
        "blur": { "type": "number", "minimum": 0, "maximum": 40 },
        "animation": { "enum": ["none", "ken-burns", "drift", "pulse"] },
        "durationSeconds": { "type": "number", "minimum": 2, "maximum": 120 }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "type": { "enum": ["image", "video"] } }, "required": ["type"] },
          "then": { "required": ["src"] }
        },
        {
          "if": { "properties": { "type": { "const": "gradient" } }, "required": ["type"] },
          "then": { "required": ["gradient"] }
        },
        {
          "if": { "properties": { "type": { "const": "video" } }, "required": ["type"] },
          "then": { "required": ["poster"] }
        }
      ]
    },
    "fontAsset": {
      "type": "object",
      "required": ["family", "src"],
      "properties": {
        "family": { "type": "string", "minLength": 1, "maxLength": 100 },
        "src": { "$ref": "#/$defs/resourcePath" },
        "weight": { "type": "string", "minLength": 1, "maxLength": 30 },
        "style": { "type": "string", "minLength": 1, "maxLength": 30 }
      },
      "additionalProperties": false
    },
    "typography": {
      "type": "object",
      "properties": {
        "ui": { "type": "string", "minLength": 1, "maxLength": 300 },
        "body": { "type": "string", "minLength": 1, "maxLength": 300 },
        "code": { "type": "string", "minLength": 1, "maxLength": 300 },
        "scale": { "type": "number", "minimum": 0.85, "maximum": 1.25 },
        "lineHeight": { "type": "number", "minimum": 1.2, "maximum": 2 },
        "assets": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/fontAsset" }
        }
      },
      "additionalProperties": false
    },
    "layout": {
      "type": "object",
      "properties": {
        "density": { "enum": ["compact", "comfortable", "spacious"] },
        "sidebarWidth": { "type": "number", "minimum": 180, "maximum": 360 },
        "chatMaxWidth": { "type": "number", "minimum": 620, "maximum": 1200 },
        "composerMaxWidth": { "type": "number", "minimum": 520, "maximum": 1000 },
        "selfMessageMaxWidth": { "type": "number", "minimum": 220, "maximum": 720 },
        "chatMargin": { "type": "number", "minimum": 8, "maximum": 64 }
      },
      "additionalProperties": false
    },
    "composer": {
      "type": "object",
      "properties": {
        "background": { "type": "string", "minLength": 1, "maxLength": 300 },
        "border": { "type": "string", "minLength": 1, "maxLength": 300 },
        "textColor": { "type": "string", "minLength": 1, "maxLength": 300 },
        "placeholderColor": { "type": "string", "minLength": 1, "maxLength": 300 },
        "caretColor": { "type": "string", "minLength": 1, "maxLength": 300 },
        "iconColor": { "type": "string", "minLength": 1, "maxLength": 300 },
        "sendButtonBackground": { "type": "string", "minLength": 1, "maxLength": 300 },
        "sendButtonIconColor": { "type": "string", "minLength": 1, "maxLength": 300 },
        "radius": { "type": "number", "minimum": 0, "maximum": 40 },
        "minHeight": { "type": "number", "minimum": 40, "maximum": 180 },
        "maxHeight": { "type": "number", "minimum": 120, "maximum": 480 },
        "padding": { "type": "number", "minimum": 4, "maximum": 32 },
        "gap": { "type": "number", "minimum": 4, "maximum": 32 },
        "iconSize": { "type": "number", "minimum": 14, "maximum": 32 }
      },
      "additionalProperties": false
    },
    "content": {
      "type": "object",
      "properties": {
        "chatBackground": { "type": "string", "minLength": 1, "maxLength": 300 },
        "userMessageBackground": { "type": "string", "minLength": 1, "maxLength": 300 },
        "userMessageText": { "type": "string", "minLength": 1, "maxLength": 300 },
        "assistantMessageBackground": { "type": "string", "minLength": 1, "maxLength": 300 },
        "assistantMessageText": { "type": "string", "minLength": 1, "maxLength": 300 },
        "codeBackground": { "type": "string", "minLength": 1, "maxLength": 300 },
        "codeHeaderBackground": { "type": "string", "minLength": 1, "maxLength": 300 },
        "selectionColor": { "type": "string", "minLength": 1, "maxLength": 300 },
        "scrollbarColor": { "type": "string", "minLength": 1, "maxLength": 300 },
        "scrollbarHoverColor": { "type": "string", "minLength": 1, "maxLength": 300 }
      },
      "additionalProperties": false
    },
    "icons": {
      "type": "object",
      "properties": {
        "main": { "$ref": "#/$defs/resourcePath" },
        "newTask": { "$ref": "#/$defs/resourcePath" },
        "scheduled": { "$ref": "#/$defs/resourcePath" },
        "skills": { "$ref": "#/$defs/resourcePath" },
        "cloud": { "$ref": "#/$defs/resourcePath" },
        "remote": { "$ref": "#/$defs/resourcePath" },
        "conversation": { "$ref": "#/$defs/resourcePath" },
        "project": { "$ref": "#/$defs/resourcePath" },
        "confirm": { "$ref": "#/$defs/resourcePath" },
        "connector": { "$ref": "#/$defs/resourcePath" },
        "send": { "$ref": "#/$defs/resourcePath" },
        "stop": { "$ref": "#/$defs/resourcePath" },
        "attach": { "$ref": "#/$defs/resourcePath" },
        "voice": { "$ref": "#/$defs/resourcePath" },
        "tools": { "$ref": "#/$defs/resourcePath" },
        "knowledge": { "$ref": "#/$defs/resourcePath" },
        "moreSkills": { "$ref": "#/$defs/resourcePath" },
        "dailyWork": { "$ref": "#/$defs/resourcePath" },
        "contentCreation": { "$ref": "#/$defs/resourcePath" },
        "research": { "$ref": "#/$defs/resourcePath" },
        "design": { "$ref": "#/$defs/resourcePath" },
        "readAloud": { "$ref": "#/$defs/resourcePath" },
        "copy": { "$ref": "#/$defs/resourcePath" },
        "sidebar": { "$ref": "#/$defs/resourcePath" }
      },
      "additionalProperties": false
    },
    "effects": {
      "type": "object",
      "properties": {
        "radiusScale": { "type": "number", "minimum": 0, "maximum": 2 },
        "shadow": { "type": "string", "minLength": 1, "maxLength": 300 },
        "blur": { "type": "number", "minimum": 0, "maximum": 60 },
        "motion": { "enum": ["normal", "gentle", "reduced", "none", "off"] },
        "transitionMs": { "type": "integer", "minimum": 0, "maximum": 1000 }
      },
      "additionalProperties": false
    },
    "nullableString": { "type": ["string", "null"] },
    "nullableNumber": { "type": ["number", "null"] },
    "targetBackground": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "properties": {
            "type": { "oneOf": [{ "enum": ["image", "video", "gradient"] }, { "type": "null" }] },
            "src": { "oneOf": [{ "$ref": "#/$defs/resourcePath" }, { "type": "null" }] },
            "poster": { "oneOf": [{ "$ref": "#/$defs/resourcePath" }, { "type": "null" }] },
            "gradient": { "$ref": "#/$defs/nullableString" },
            "fit": { "oneOf": [{ "enum": ["cover", "contain", "fill", "none", "scale-down"] }, { "type": "null" }] },
            "position": { "$ref": "#/$defs/nullableString" },
            "opacity": { "oneOf": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "type": "null" }] },
            "veil": { "oneOf": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "type": "null" }] },
            "blur": { "oneOf": [{ "type": "number", "minimum": 0, "maximum": 40 }, { "type": "null" }] },
            "animation": { "oneOf": [{ "enum": ["none", "ken-burns", "drift", "pulse"] }, { "type": "null" }] },
            "durationSeconds": { "oneOf": [{ "type": "number", "minimum": 2, "maximum": 120 }, { "type": "null" }] }
          },
          "additionalProperties": false
        }
      ]
    },
    "targetTypography": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "properties": {
            "ui": { "$ref": "#/$defs/nullableString" },
            "body": { "$ref": "#/$defs/nullableString" },
            "code": { "$ref": "#/$defs/nullableString" },
            "scale": { "oneOf": [{ "type": "number", "minimum": 0.85, "maximum": 1.25 }, { "type": "null" }] },
            "lineHeight": { "oneOf": [{ "type": "number", "minimum": 1.2, "maximum": 2 }, { "type": "null" }] },
            "assets": { "oneOf": [{ "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/fontAsset" } }, { "type": "null" }] }
          },
          "additionalProperties": false
        }
      ]
    },
    "targetLayout": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "properties": {
            "density": { "oneOf": [{ "enum": ["compact", "comfortable", "spacious"] }, { "type": "null" }] },
            "sidebarWidth": { "oneOf": [{ "type": "number", "minimum": 180, "maximum": 360 }, { "type": "null" }] },
            "chatMaxWidth": { "oneOf": [{ "type": "number", "minimum": 620, "maximum": 1200 }, { "type": "null" }] },
            "composerMaxWidth": { "oneOf": [{ "type": "number", "minimum": 520, "maximum": 1000 }, { "type": "null" }] },
            "selfMessageMaxWidth": { "oneOf": [{ "type": "number", "minimum": 220, "maximum": 720 }, { "type": "null" }] },
            "chatMargin": { "oneOf": [{ "type": "number", "minimum": 8, "maximum": 64 }, { "type": "null" }] }
          },
          "additionalProperties": false
        }
      ]
    },
    "targetComposer": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "properties": {
            "background": { "$ref": "#/$defs/nullableString" },
            "border": { "$ref": "#/$defs/nullableString" },
            "textColor": { "$ref": "#/$defs/nullableString" },
            "placeholderColor": { "$ref": "#/$defs/nullableString" },
            "caretColor": { "$ref": "#/$defs/nullableString" },
            "iconColor": { "$ref": "#/$defs/nullableString" },
            "sendButtonBackground": { "$ref": "#/$defs/nullableString" },
            "sendButtonIconColor": { "$ref": "#/$defs/nullableString" },
            "radius": { "oneOf": [{ "type": "number", "minimum": 0, "maximum": 40 }, { "type": "null" }] },
            "minHeight": { "oneOf": [{ "type": "number", "minimum": 40, "maximum": 180 }, { "type": "null" }] },
            "maxHeight": { "oneOf": [{ "type": "number", "minimum": 120, "maximum": 480 }, { "type": "null" }] },
            "padding": { "oneOf": [{ "type": "number", "minimum": 4, "maximum": 32 }, { "type": "null" }] },
            "gap": { "oneOf": [{ "type": "number", "minimum": 4, "maximum": 32 }, { "type": "null" }] },
            "iconSize": { "oneOf": [{ "type": "number", "minimum": 14, "maximum": 32 }, { "type": "null" }] }
          },
          "additionalProperties": false
        }
      ]
    },
    "targetContent": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "properties": {
            "chatBackground": { "$ref": "#/$defs/nullableString" },
            "userMessageBackground": { "$ref": "#/$defs/nullableString" },
            "userMessageText": { "$ref": "#/$defs/nullableString" },
            "assistantMessageBackground": { "$ref": "#/$defs/nullableString" },
            "assistantMessageText": { "$ref": "#/$defs/nullableString" },
            "codeBackground": { "$ref": "#/$defs/nullableString" },
            "codeHeaderBackground": { "$ref": "#/$defs/nullableString" },
            "selectionColor": { "$ref": "#/$defs/nullableString" },
            "scrollbarColor": { "$ref": "#/$defs/nullableString" },
            "scrollbarHoverColor": { "$ref": "#/$defs/nullableString" }
          },
          "additionalProperties": false
        }
      ]
    },
    "targetIcons": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "properties": {
            "main": { "oneOf": [{ "$ref": "#/$defs/resourcePath" }, { "type": "null" }] },
            "newTask": { "oneOf": [{ "$ref": "#/$defs/resourcePath" }, { "type": "null" }] },
            "scheduled": { "oneOf": [{ "$ref": "#/$defs/resourcePath" }, { "type": "null" }] },
            "skills": { "oneOf": [{ "$ref": "#/$defs/resourcePath" }, { "type": "null" }] },
            "cloud": { "oneOf": [{ "$ref": "#/$defs/resourcePath" }, { "type": "null" }] },
            "remote": { "oneOf": [{ "$ref": "#/$defs/resourcePath" }, { "type": "null" }] },
            "conversation": { "oneOf": [{ "$ref": "#/$defs/resourcePath" }, { "type": "null" }] },
            "project": { "oneOf": [{ "$ref": "#/$defs/resourcePath" }, { "type": "null" }] },
            "confirm": { "oneOf": [{ "$ref": "#/$defs/resourcePath" }, { "type": "null" }] },
            "connector": { "oneOf": [{ "$ref": "#/$defs/resourcePath" }, { "type": "null" }] },
            "send": { "oneOf": [{ "$ref": "#/$defs/resourcePath" }, { "type": "null" }] },
            "stop": { "oneOf": [{ "$ref": "#/$defs/resourcePath" }, { "type": "null" }] },
            "attach": { "oneOf": [{ "$ref": "#/$defs/resourcePath" }, { "type": "null" }] },
            "voice": { "oneOf": [{ "$ref": "#/$defs/resourcePath" }, { "type": "null" }] },
            "tools": { "oneOf": [{ "$ref": "#/$defs/resourcePath" }, { "type": "null" }] },
            "knowledge": { "oneOf": [{ "$ref": "#/$defs/resourcePath" }, { "type": "null" }] },
            "moreSkills": { "oneOf": [{ "$ref": "#/$defs/resourcePath" }, { "type": "null" }] },
            "dailyWork": { "oneOf": [{ "$ref": "#/$defs/resourcePath" }, { "type": "null" }] },
            "contentCreation": { "oneOf": [{ "$ref": "#/$defs/resourcePath" }, { "type": "null" }] },
            "research": { "oneOf": [{ "$ref": "#/$defs/resourcePath" }, { "type": "null" }] },
            "design": { "oneOf": [{ "$ref": "#/$defs/resourcePath" }, { "type": "null" }] },
            "readAloud": { "oneOf": [{ "$ref": "#/$defs/resourcePath" }, { "type": "null" }] },
            "copy": { "oneOf": [{ "$ref": "#/$defs/resourcePath" }, { "type": "null" }] },
            "sidebar": { "oneOf": [{ "$ref": "#/$defs/resourcePath" }, { "type": "null" }] }
          },
          "additionalProperties": false
        }
      ]
    },
    "targetEffects": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "properties": {
            "radiusScale": { "oneOf": [{ "type": "number", "minimum": 0, "maximum": 2 }, { "type": "null" }] },
            "shadow": { "$ref": "#/$defs/nullableString" },
            "blur": { "oneOf": [{ "type": "number", "minimum": 0, "maximum": 60 }, { "type": "null" }] },
            "motion": { "oneOf": [{ "enum": ["normal", "gentle", "reduced", "none", "off"] }, { "type": "null" }] },
            "transitionMs": { "oneOf": [{ "type": "integer", "minimum": 0, "maximum": 1000 }, { "type": "null" }] }
          },
          "additionalProperties": false
        }
      ]
    },
    "sharedVariant": {
      "type": "object",
      "properties": {
        "background": { "$ref": "#/$defs/targetBackground" },
        "surfaceOpacity": { "oneOf": [{ "type": "number", "minimum": 0.35, "maximum": 1 }, { "type": "null" }] },
        "typography": { "$ref": "#/$defs/targetTypography" },
        "layout": { "$ref": "#/$defs/targetLayout" },
        "composer": { "$ref": "#/$defs/targetComposer" },
        "content": { "$ref": "#/$defs/targetContent" },
        "icons": { "$ref": "#/$defs/targetIcons" },
        "effects": { "$ref": "#/$defs/targetEffects" },
        "css": { "$ref": "#/$defs/cssList" }
      },
      "additionalProperties": false
    },
    "sharedLayer": {
      "type": "object",
      "required": ["appearance"],
      "properties": {
        "appearance": { "$ref": "#/$defs/appearance" },
        "background": { "$ref": "#/$defs/background" },
        "surfaceOpacity": { "type": "number", "minimum": 0.35, "maximum": 1 },
        "typography": { "$ref": "#/$defs/typography" },
        "layout": { "$ref": "#/$defs/layout" },
        "composer": { "$ref": "#/$defs/composer" },
        "content": { "$ref": "#/$defs/content" },
        "icons": { "$ref": "#/$defs/icons" },
        "effects": { "$ref": "#/$defs/effects" },
        "css": { "$ref": "#/$defs/cssList" },
        "variants": {
          "type": "object",
          "properties": {
            "light": { "$ref": "#/$defs/sharedVariant" },
            "dark": { "$ref": "#/$defs/sharedVariant" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "targetVariant": {
      "type": "object",
      "properties": {
        "background": { "$ref": "#/$defs/targetBackground" },
        "surfaceOpacity": { "oneOf": [{ "type": "number", "minimum": 0.35, "maximum": 1 }, { "type": "null" }] },
        "typography": { "$ref": "#/$defs/targetTypography" },
        "layout": { "$ref": "#/$defs/targetLayout" },
        "composer": { "$ref": "#/$defs/targetComposer" },
        "content": { "$ref": "#/$defs/targetContent" },
        "icons": { "$ref": "#/$defs/targetIcons" },
        "effects": { "$ref": "#/$defs/targetEffects" },
        "css": { "$ref": "#/$defs/cssList" }
      },
      "additionalProperties": false
    },
    "targetLayer": {
      "type": "object",
      "properties": {
        "appearance": { "$ref": "#/$defs/appearance" },
        "background": { "$ref": "#/$defs/targetBackground" },
        "surfaceOpacity": { "oneOf": [{ "type": "number", "minimum": 0.35, "maximum": 1 }, { "type": "null" }] },
        "typography": { "$ref": "#/$defs/targetTypography" },
        "layout": { "$ref": "#/$defs/targetLayout" },
        "composer": { "$ref": "#/$defs/targetComposer" },
        "content": { "$ref": "#/$defs/targetContent" },
        "icons": { "$ref": "#/$defs/targetIcons" },
        "effects": { "$ref": "#/$defs/targetEffects" },
        "css": { "$ref": "#/$defs/cssList" },
        "variants": {
          "type": "object",
          "properties": {
            "light": { "$ref": "#/$defs/targetVariant" },
            "dark": { "$ref": "#/$defs/targetVariant" }
          },
          "additionalProperties": false
        },
        "preview": { "$ref": "#/$defs/preview" }
      },
      "additionalProperties": false
    },
    "targets": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "doubao": { "$ref": "#/$defs/targetLayer" },
        "doubao-work": { "$ref": "#/$defs/targetLayer" },
        "workbuddy": { "$ref": "#/$defs/targetLayer" }
      },
      "additionalProperties": false
    }
  }
}
