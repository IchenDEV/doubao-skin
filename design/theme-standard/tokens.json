{
  "name": "doubao-skin-standard",
  "version": 1,
  "purpose": "Design reference; runtime themes continue to use theme.json and theme.css.",
  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 20,
    "2xl": 24,
    "3xl": 32
  },
  "radius": {
    "control": 6,
    "selection": 7,
    "preview": 10,
    "window": "native"
  },
  "typography": {
    "family": "SF Pro",
    "title": {
      "size": 17,
      "weight": 600
    },
    "themeName": {
      "size": 14,
      "weight": 500
    },
    "body": {
      "size": 13,
      "weight": 400
    },
    "caption": {
      "size": 12,
      "weight": 400
    }
  },
  "shell": {
    "windowBackground": "macOS.windowBackground",
    "sidebarBackground": "macOS.sidebarMaterial",
    "surface": "macOS.controlBackground",
    "separator": "macOS.separator",
    "textPrimary": "macOS.label",
    "textSecondary": "macOS.secondaryLabel",
    "focus": "macOS.keyboardFocusIndicator",
    "selection": "theme.accent at 18 percent opacity",
    "primaryAction": "theme.accent",
    "danger": "macOS.systemRed"
  },
  "motion": {
    "stateChangeMs": 120,
    "previewCrossfadeMs": 180,
    "reduceMotionFallback": "instant"
  },
  "themePreview": {
    "requiredVariables": [
      "--dbx-bg-body-web",
      "--s-color-bg-body",
      "--semi-color-primary"
    ],
    "swatches": [
      "sidebar",
      "main",
      "accent"
    ]
  }
}
